<section class="section" style="background: var(--navy); padding: clamp(2rem, 4vw, 3rem) 0 clamp(1.5rem, 3vw, 2rem); color: #fff;">
  <div class="container">
    <div class="section-eyebrow" style="color: var(--orange-light)">Store Administration</div>
    <h1 style="color:#fff; font-size: clamp(22px, 3.5vw, 32px); margin-bottom: 0.5rem;">Tech Talk Mobile Management Portal</h1>
    <div style="display: flex; gap: 8px; margin-top: 1rem; flex-wrap: wrap;">
      <a href="/admin/products" class="btn btn-orange btn-sm">
        <%- icon('box', 14) %> Inventory Products
      </a>
      <a href="/admin/products/new" class="btn btn-outline btn-sm">
        <%- icon('plus', 14) %> Add Product
      </a>
      <a href="/admin/categories" class="btn btn-outline btn-sm">
        <%- icon('grid', 14) %> Categories
      </a>
      <a href="/admin/inquiries" class="btn btn-outline btn-sm">
        <%- icon('messageSquare', 14) %> Customer Leads (<%= stats.inquiries %>)
      </a>
      <a href="/admin/reviews" class="btn btn-outline btn-sm">
        <%- icon('star', 14) %> Reviews (<%= stats.reviews %>)
      </a>
      <a href="/admin/settings" class="btn btn-outline btn-sm">
        <%- icon('settings', 14) %> Store Settings
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div class="alert alert-success">
        <span style="display:inline-flex; align-items:center; gap:6px;">
          <%- icon('check', 16) %> <%= successMsg %>
        </span>
      </div>
    <% } %>

    <!-- Quick Stats Metric Cards -->
    <div class="admin-stat-grid">
      <div class="stat-card-admin">
        <div class="stat-card-icon" style="color: var(--orange); background: var(--orange-subtle);">
          <%- icon('box', 24) %>
        </div>
        <div>
          <div class="stat-card-label">Total Inventory</div>
          <div class="stat-card-num"><%= stats.products %></div>
        </div>
      </div>

      <div class="stat-card-admin">
        <div class="stat-card-icon" style="color: var(--teal); background: var(--teal-subtle);">
          <%- icon('grid', 24) %>
        </div>
        <div>
          <div class="stat-card-label">Categories</div>
          <div class="stat-card-num"><%= stats.categories %></div>
        </div>
      </div>

      <div class="stat-card-admin">
        <div class="stat-card-icon" style="color: #ffb703; background: rgba(255, 183, 3, 0.15);">
          <%- icon('starFilled', 24) %>
        </div>
        <div>
          <div class="stat-card-label">Customer Reviews</div>
          <div class="stat-card-num"><%= stats.reviews %></div>
        </div>
      </div>

      <div class="stat-card-admin">
        <div class="stat-card-icon" style="color: var(--whatsapp); background: rgba(37, 211, 102, 0.15);">
          <%- icon('messageSquare', 24) %>
        </div>
        <div>
          <div class="stat-card-label">Customer Inquiries</div>
          <div class="stat-card-num"><%= stats.inquiries %></div>
        </div>
      </div>
    </div>

    <!-- Split Grid: Recent Products & Inquiries -->
    <div class="admin-split-grid">
      
      <!-- Recent Inventory Updates -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">Latest Added Accessories</h3>
          <a href="/admin/products" class="btn btn-outline-dark btn-sm">Manage All</a>
        </div>

        <% if (recentProducts && recentProducts.length > 0) { %>
          <div class="admin-item-list">
            <% recentProducts.forEach(p => { %>
              <div class="admin-item-row">
                <div class="admin-item-info">
                  <img src="<%= p.image_url %>" alt="" class="admin-item-thumb">
                  <div class="admin-item-text">
                    <div class="admin-item-name"><%= p.name %></div>
                    <div class="admin-item-meta"><%= p.category_name || 'Accessory' %> · ₹<%= p.price %></div>
                  </div>
                </div>
                <div class="admin-item-actions">
                  <a href="/admin/products/edit/<%= p.id %>" class="btn btn-outline-dark btn-sm" style="padding: 4px 10px; font-size: 12px;">Edit</a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color: var(--gray-500); font-size: 13px;">No accessories added yet.</p>
        <% } %>
      </div>

      <!-- Recent Inquiries -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">Recent Inquiries & Leads</h3>
          <a href="/admin/inquiries" class="btn btn-outline-dark btn-sm">View All</a>
        </div>

        <% if (recentInquiries && recentInquiries.length > 0) { %>
          <div class="admin-item-list">
            <% recentInquiries.forEach(inq => { %>
              <div style="padding-bottom: 12px; border-bottom: 1px solid var(--gray-200);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; flex-wrap: wrap; gap: 4px;">
                  <strong style="font-size: 13.5px; color: var(--navy);"><%= inq.customer_name %></strong>
                  <span class="badge <%= inq.status === 'resolved' ? 'badge-new' : 'badge-hot' %>" style="font-size: 10px;"><%= inq.status %></span>
                </div>
                <div style="font-size: 12.5px; color: var(--gray-600); margin-bottom: 8px; word-break: break-word;"><%= inq.product_name || inq.message %></div>
                <a href="https://wa.me/<%= inq.phone.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm" style="padding: 4px 10px; font-size: 11.5px; width: fit-content;">
                  <%- icon('whatsapp', 12) %> WhatsApp <%= inq.phone %>
                </a>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color: var(--gray-500); font-size: 13px;">No pending inquiries at the moment.</p>
        <% } %>
      </div>

    </div>
  </div>
</section>

<section class="section" style="background: var(--navy); padding: 2.5rem 1.5rem; color: #fff;">
  <div class="container">
    <div style="font-size: 13px; color: rgba(255,255,255,0.7); margin-bottom: 0.5rem;">
      <a href="/admin" style="color: rgba(255,255,255,0.7);">Dashboard</a> / Products
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="color:#fff; font-size: 26px;">Product Inventory Management</h1>
        <p style="font-size: 13.5px; color: rgba(255,255,255,0.7);">Real-time control over products, stock availability, pricing, and promotional badges.</p>
      </div>
      <a href="/admin/products/new" class="btn btn-orange">
        <%- icon('plus', 16) %> Add New Accessory
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div class="alert alert-success">
        <span style="display:inline-flex; align-items:center; gap:6px;">
          <%- icon('check', 16) %> <%= successMsg %>
        </span>
      </div>
    <% } %>

    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th style="width: 50px;">Image</th>
            <th>Name & Details</th>
            <th>Category</th>
            <th>Price</th>
            <th>Badge</th>
            <th>Stock Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(prod => { %>
              <tr>
                <td>
                  <img src="<%= prod.image_url %>" alt="" style="width: 46px; height: 46px; object-fit: cover; border-radius: 6px; background: #f0f0f0;">
                </td>
                <td>
                  <div style="font-weight: 700; color: var(--navy);"><%= prod.name %></div>
                  <div style="font-size: 11px; color: var(--gray-500);"><%= prod.slug %></div>
                  <% if (prod.is_featured) { %>
                    <span style="font-size: 10px; color: var(--orange); font-weight: 700; background: var(--orange-subtle); padding: 1px 6px; border-radius: 4px;">Featured on Home</span>
                  <% } %>
                </td>
                <td><%= prod.category_name || '-' %></td>
                <td>
                  <div style="font-weight: 700; color: var(--navy);">₹<%= prod.price %></div>
                  <% if (prod.original_price) { %>
                    <div style="font-size: 11px; text-decoration: line-through; color: var(--gray-400);">₹<%= prod.original_price %></div>
                  <% } %>
                </td>
                <td>
                  <% if (prod.badge) { %>
                    <span class="badge badge-<%= prod.badge.toLowerCase() %>"><%= prod.badge %></span>
                  <% } else { %>
                    <span style="color: var(--gray-400); font-size: 12px;">—</span>
                  <% } %>
                </td>
                <td>
                  <form action="/admin/products/<%= prod.id %>/toggle-stock" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm <%= prod.in_stock ? 'btn-outline' : 'btn-orange' %>" 
                            style="<%= prod.in_stock ? 'color:#0f5132; background:#d1e7dd; border-color:#badbcc;' : 'background:#ffe3e3; color:#c92a2a; border-color:#f5c2c7;' %>">
                      <%- icon(prod.in_stock ? 'check' : 'x', 12) %>
                      <%= prod.in_stock ? 'In Stock' : 'Out of Stock' %>
                    </button>
                  </form>
                </td>
                <td>
                  <div style="display: flex; gap: 6px;">
                    <a href="/admin/products/edit/<%= prod.id %>" class="btn btn-outline-dark btn-sm" title="Edit Accessory">
                      <%- icon('edit', 14) %> Edit
                    </a>
                    <form action="/admin/products/delete/<%= prod.id %>" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this product?');" style="display:inline;">
                      <button type="submit" class="btn btn-sm" style="background: #ffe3e3; color: #c92a2a; border: 1px solid #f5c2c7;" title="Delete Accessory">
                        <%- icon('trash', 14) %>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 2.5rem; color: var(--gray-500);">
                No accessories found in inventory. Click "Add New Accessory" to create one.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

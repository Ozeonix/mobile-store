<!-- Category Landing Hub -->
<section class="section catalog-header-section">
  <div class="container">
    <div class="breadcrumb-trail">
      <a href="/">Home</a> / 
      <a href="/products">Categories</a> / 
      <span class="breadcrumb-current"><%= category.name %></span>
    </div>

    <div class="category-header-title-row">
      <div class="category-header-icon-wrap">
        <%- icon(category.icon || 'smartphone', 32) %>
      </div>
      <div>
        <h1 class="catalog-title"><%= category.name %></h1>
        <p class="catalog-subtitle">
          <%= category.description %> Walk in to our showroom in AECS Layout, Brookefield for same-day selection and complimentary fitting.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header-flex">
      <div>
        <div class="section-eyebrow">Category Catalog</div>
        <h2 class="section-title"><%= category.name %> (<%= products ? products.length : 0 %> items)</h2>
      </div>
      <a href="/products" class="btn btn-outline-dark btn-sm">
        All Categories <%- icon('arrowRight', 14) %>
      </a>
    </div>

    <% if (products && products.length > 0) { %>
      <div class="product-grid">
        <% products.forEach(prod => { %>
          <div class="product-card" id="cat-prod-<%= prod.id %>">
            <div class="product-img-wrap">
              <% if (prod.badge) { %>
                <div class="product-badge-pos">
                  <span class="badge badge-<%= prod.badge.toLowerCase() %>"><%= prod.badge %></span>
                </div>
              <% } %>
              
              <a href="/products/<%= prod.slug || prod.id %>" class="product-img-link">
                <img src="<%= prod.image_url || '/images/hero-banner.png' %>" 
                     alt="<%= prod.name %>" 
                     loading="lazy" 
                     class="product-thumb">
              </a>
            </div>

            <div class="product-body">
              <h3 class="product-name">
                <a href="/products/<%= prod.slug || prod.id %>"><%= prod.name %></a>
              </h3>

              <p class="product-desc"><%= prod.description %></p>

              <!-- Price Row -->
              <div class="product-price-row">
                <div class="price-wrap">
                  <span class="price-current">₹<%= Number(prod.price).toLocaleString('en-IN') %></span>
                  <% if (prod.original_price && Number(prod.original_price) > Number(prod.price)) { %>
                    <span class="price-original">₹<%= Number(prod.original_price).toLocaleString('en-IN') %></span>
                    <% const discount = Math.round(((Number(prod.original_price) - Number(prod.price)) / Number(prod.original_price)) * 100); %>
                    <span class="price-discount-badge"><%= discount %>% OFF</span>
                  <% } %>
                </div>

                <div class="stock-indicator <%= prod.in_stock ? 'in-stock' : 'out-stock' %>">
                  <span class="stock-dot"></span>
                  <span><%= prod.in_stock ? 'In Stock' : 'Out of Stock' %></span>
                </div>
              </div>

              <!-- Action Row -->
              <div class="product-action-row">
                <a href="/products/<%= prod.slug || prod.id %>" class="btn btn-outline btn-sm product-view-btn">
                  Details
                </a>
                <a href="https://wa.me/<%= settings.store_whatsapp || '919876543210' %>?text=<%= encodeURIComponent('Hi Tech Talk Mobile! I want to check availability for: ' + prod.name + ' in ' + category.name) %>"
                   class="btn btn-whatsapp btn-sm product-wa-btn" 
                   target="_blank" 
                   rel="noopener"
                   title="Reserve on WhatsApp">
                  <%- icon('whatsapp', 15) %> <span class="wa-btn-label">WhatsApp</span>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state-card">
        <p style="color: var(--gray-500); margin-bottom: 1rem;">No items currently listed under this category.</p>
        <a href="/products" class="btn btn-orange">Browse All Products</a>
      </div>
    <% } %>
  </div>
</section>

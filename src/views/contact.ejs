<!-- Contact / Store Visit Landing Page -->
<section class="section" style="background: var(--navy); padding: 3rem 1.5rem 2rem;">
  <div class="container">
    <div class="section-eyebrow" style="color: var(--orange-light)">Visit Us in AECS Layout</div>
    <h1 style="font-family:'Space Grotesk',sans-serif; color:#fff; font-size:clamp(26px, 4vw, 36px); margin-bottom: 0.5rem;">
      Store Location & Contact
    </h1>
    <p style="color: rgba(255,255,255,0.7); font-size: 14px; max-width: 600px;">
      Walk in to our showroom opposite Kanti Sweets in B Block, AECS Layout. Free tempered glass fitting and instant product demonstrations available.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div class="alert alert-success">
        <span style="display:inline-flex; align-items:center; gap:6px;">
          <%- icon('check', 16) %> <%= successMsg %>
        </span>
      </div>
    <% } %>

    <div class="contact-layout">
      <!-- Store Location Info -->
      <div>
        <a href="<%= settings.google_maps_url || 'https://maps.google.com/?q=AECS+Layout+Brookefield+Bengaluru+opposite+Kanti+Sweets' %>"
           class="map-placeholder fade-up" target="_blank" rel="noopener">
          <div class="map-glow"></div>
          <div class="map-pin" style="color: var(--orange);">
            <%- icon('mapPin', 40) %>
          </div>
          <div class="map-label">Tech Talk Mobile</div>
          <div class="map-sub">Tap to open in Google Maps (Brookefield, Bengaluru)</div>
        </a>

        <div class="contact-card fade-up">
          <div class="contact-row">
            <div class="contact-ico" style="color: var(--orange);">
              <%- icon('mapPin', 20) %>
            </div>
            <div>
              <div class="contact-label">Address</div>
              <div class="contact-val">
                <%= settings.store_address || 'Opposite Kanti Sweets, B Block, AECS Layout, Brookefield, Bengaluru – 560037' %>
              </div>
            </div>
          </div>
          <div class="contact-row">
            <div class="contact-ico" style="color: var(--teal);">
              <%- icon('clock', 20) %>
            </div>
            <div>
              <div class="contact-label">Store Hours</div>
              <div class="contact-val">
                <%= settings.store_hours || 'Mon – Sat · 9:00 AM – 8:00 PM' %>
              </div>
            </div>
          </div>
          <div class="contact-row">
            <div class="contact-ico" style="color: var(--orange);">
              <%- icon('phone', 20) %>
            </div>
            <div>
              <div class="contact-label">Phone</div>
              <div class="contact-val">
                <%= settings.store_phone || '+91 98765 43210' %>
              </div>
            </div>
          </div>
          <div class="contact-row">
            <div class="contact-ico" style="color: var(--whatsapp);">
              <%- icon('whatsapp', 20) %>
            </div>
            <div>
              <div class="contact-label">WhatsApp</div>
              <div class="contact-val">Direct chat for pricing & model compatibility</div>
            </div>
          </div>
        </div>

        <div class="cta-row fade-up" style="display: flex; gap: 12px;">
          <a href="https://wa.me/<%= settings.store_whatsapp || '919876543210' %>?text=Hi%20Tech%20Talk%20Mobile!%20I'm%20planning%20to%20visit%20your%20store."
             class="btn btn-whatsapp" target="_blank" rel="noopener" style="flex: 1;">
            <%- icon('whatsapp', 16) %> Chat on WhatsApp
          </a>
          <a href="tel:<%= (settings.store_phone || '+919876543210').replace(/\s+/g, '') %>"
             class="btn btn-orange" style="flex: 1;">
            <%- icon('phone', 16) %> Call Store
          </a>
        </div>
      </div>

      <!-- In-Store Inquiry Form -->
      <div class="form-card fade-up">
        <div class="section-eyebrow">Direct Message</div>
        <div class="section-title" style="font-size: 20px; margin-bottom: 8px;">Contact Our Staff</div>
        <p style="font-size: 13px; color: var(--gray-500); margin-bottom: 1.5rem;">
          Have questions about pricing, bulk purchases, or special mobile accessories? Let us know.
        </p>

        <form action="/contact/inquiry" method="POST">
          <div class="form-group">
            <label class="form-label" for="customer_name">Your Name</label>
            <input type="text" id="customer_name" name="customer_name" class="form-input"
                   placeholder="e.g. Priyesh Nair" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="phone">Phone / WhatsApp Number</label>
            <input type="tel" id="phone" name="phone" class="form-input" placeholder="e.g. +91 98765 43210"
                   required>
          </div>

          <div class="form-group">
            <label class="form-label" for="product_name">Product / Phone Model</label>
            <input type="text" id="product_name" name="product_name" class="form-input"
                   placeholder="e.g. Samsung Galaxy S24 Ultra Glass">
          </div>

          <div class="form-group">
            <label class="form-label" for="message">Your Message</label>
            <textarea id="message" name="message" class="form-textarea" placeholder="Write your question here..."
                      required></textarea>
          </div>

          <button type="submit" class="btn btn-orange" style="width: 100%;">
            <%- icon('check', 16) %> Submit Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
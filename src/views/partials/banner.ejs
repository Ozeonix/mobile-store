<div class="top-banner">
  <div class="banner-content">
    <div class="banner-ticker">
      <span class="banner-badge">AECS Layout Showroom</span>
      <span style="display: inline-flex; align-items: center; gap: 4px;">
        <%- icon('mapPin', 14) %> Opposite Kanti Sweets, B Block, Brookefield, Bengaluru
      </span>
      <span style="opacity: 0.8; display: inline-flex; align-items: center; gap: 4px;">
        <%- icon('check', 14) %> Free Tempered Glass Fitting
      </span>
    </div>
    <div class="banner-links">
      <a href="tel:<%= (settings.store_phone || '+919876543210').replace(/\s+/g, '') %>">
        <%- icon('phone', 13) %> <%= settings.store_phone || '+91 98765 43210' %>
      </a>
      <a href="https://wa.me/<%= settings.store_whatsapp || '919876543210' %>" target="_blank" rel="noopener">
        <%- icon('whatsapp', 13) %> WhatsApp
      </a>
    </div>
  </div>
</div>

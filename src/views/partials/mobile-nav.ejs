<!-- Mobile Native App-like Bottom Navigation Bar (Hidden on Desktop) -->
<nav class="mobile-app-bottom-bar" aria-label="Mobile Navigation">
  <a href="/" class="mobile-tab-item <%= page === 'home' ? 'active' : '' %>" id="tab-home">
    <span class="mobile-tab-icon"><%- icon('smartphone', 22) %></span>
    <span class="mobile-tab-label">Home</span>
  </a>
  
  <a href="/products" class="mobile-tab-item <%= page === 'products' || page === 'category' ? 'active' : '' %>" id="tab-catalog">
    <span class="mobile-tab-icon"><%- icon('grid', 22) %></span>
    <span class="mobile-tab-label">Store</span>
  </a>

  <a href="https://wa.me/<%= settings.store_whatsapp || '919876543210' %>?text=<%= encodeURIComponent('Hi Tech Talk Mobile, I want to inquire about phone accessories at your AECS Layout store.') %>" 
     target="_blank" 
     rel="noopener noreferrer" 
     class="mobile-tab-item mobile-tab-wa" 
     id="tab-whatsapp"
     title="Chat on WhatsApp">
    <span class="mobile-tab-wa-badge">
      <%- icon('whatsapp', 24) %>
    </span>
    <span class="mobile-tab-label" style="color: var(--whatsapp); font-weight: 700;">Chat</span>
  </a>

  <a href="/reviews" class="mobile-tab-item <%= page === 'reviews' ? 'active' : '' %>" id="tab-reviews">
    <span class="mobile-tab-icon"><%- icon('starFilled', 22) %></span>
    <span class="mobile-tab-label">Reviews</span>
  </a>

  <a href="/contact" class="mobile-tab-item <%= page === 'contact' ? 'active' : '' %>" id="tab-contact">
    <span class="mobile-tab-icon"><%- icon('mapPin', 22) %></span>
    <span class="mobile-tab-label">Visit</span>
  </a>
</nav>

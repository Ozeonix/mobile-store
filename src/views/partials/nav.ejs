<header class="site-header">
  <div class="container">
    <nav class="navbar">
      <!-- Brand Logo -->
      <a href="/" class="brand" id="brand-logo" aria-label="Tech Talk Mobile Homepage">
        <div class="brand-icon">
          <%- icon('zap', 22) %>
        </div>
        <div class="brand-text">
          <span class="brand-title">TECH TALK <span class="brand-highlight">MOBILE</span></span>
          <span class="brand-sub">AECS LAYOUT · BROOKEFIELD</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="nav-menu">
        <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
        <li><a href="/products" class="nav-link <%= currentPath.startsWith('/products') ? 'active' : '' %>">All Accessories</a></li>
        <li><a href="/category/screen-protectors" class="nav-link <%= currentPath.includes('screen-protectors') ? 'active' : '' %>">Screen Guards</a></li>
        <li><a href="/category/fast-chargers" class="nav-link <%= currentPath.includes('fast-chargers') ? 'active' : '' %>">Fast Chargers</a></li>
        <li><a href="/category/cases-covers" class="nav-link <%= currentPath.includes('cases-covers') ? 'active' : '' %>">Cases & Covers</a></li>
        <li><a href="/reviews" class="nav-link <%= currentPath === '/reviews' ? 'active' : '' %>">
          <span style="display:inline-flex; align-items:center; gap:4px;"><%- icon('starFilled', 13) %> Reviews</span>
        </a></li>
        <li><a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Showroom</a></li>
      </ul>

      <!-- Nav Quick Actions -->
      <div class="nav-actions">
        <a href="tel:<%= settings.store_phone || '+919876543210' %>" class="btn btn-icon-only nav-call-btn" title="Call Store" aria-label="Call Store">
          <%- icon('phone', 16) %>
        </a>

        <a href="https://wa.me/<%= settings.store_whatsapp || '919876543210' %>?text=<%= encodeURIComponent('Hi Tech Talk Mobile, I am interested in accessories at your AECS Layout store.') %>"
           class="btn btn-whatsapp btn-sm nav-wa-btn" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
          <%- icon('whatsapp', 16) %> <span class="btn-text-hide-mobile">WhatsApp</span>
        </a>

        <a href="/admin" class="btn btn-outline btn-sm nav-admin-btn" title="Admin Portal">
          <%- icon('settings', 14) %> <span class="btn-text-hide-mobile">Admin</span>
        </a>
      </div>
    </nav>
  </div>
</header>

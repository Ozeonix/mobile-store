<!-- Reviews Landing Page -->
<section class="section" style="background: var(--navy); padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2.5rem); color: #fff;">
  <div class="container">
    <div class="section-eyebrow" style="color: var(--orange-light)">Verified Customer Feedback</div>
    <h1 style="color:#fff; font-size: clamp(24px, 3.5vw, 36px); margin-bottom: 0.5rem;">
      Customer Reviews & Ratings
    </h1>
    <p style="color: rgba(255,255,255,0.75); font-size: clamp(13px, 1vw, 14.5px); max-width: 620px; line-height: 1.5;">
      Read genuine reviews from customer visits to our Brookefield, AECS Layout mobile store. We pride ourselves on transparent pricing, top quality accessories, and friendly service.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div class="alert alert-success">
        <span style="display:inline-flex; align-items:center; gap:6px;">
          <%- icon('check', 16) %> <%= successMsg %>
        </span>
      </div>
    <% } %>

    <div class="reviews-page-layout">
      
      <!-- Rating Summary Breakdown -->
      <div class="reviews-summary-card">
        <div style="text-align: center; margin-bottom: 1.5rem;">
          <div class="reviews-score-big">
            <%= averageRating %>
          </div>
          <div style="color: #ffb703; font-size: 20px; margin: 8px 0; display: flex; justify-content: center; gap: 4px;">
            <%- icon('starFilled', 20) %>
            <%- icon('starFilled', 20) %>
            <%- icon('starFilled', 20) %>
            <%- icon('starFilled', 20) %>
            <%- icon('starFilled', 20) %>
          </div>
          <div style="font-size: clamp(12.5px, 0.9vw, 13.5px); color: var(--gray-500); font-weight: 500;">
            Based on <%= totalCount %> verified customer ratings
          </div>
          <div style="display: inline-block; margin-top: 10px; background: rgba(37, 211, 102, 0.12); color: #167a39; padding: 4px 12px; border-radius: 20px; font-size: 11.5px; font-weight: 700;">
            100% Recommended Store in AECS Layout
          </div>
        </div>

        <div class="star-breakdown-list">
          <% [5, 4, 3, 2, 1].forEach(star => { 
               const count = ratingCounts[star] || 0;
               const pct = totalCount > 0 ? Math.round((count / totalCount) * 100) : (star === 5 ? 100 : 0);
          %>
            <div class="star-breakdown-row">
              <span class="star-breakdown-label"><%= star %> Star</span>
              <div class="star-breakdown-bar-bg">
                <div class="star-breakdown-bar-fill" style="width: <%= pct %>%;"></div>
              </div>
              <span class="star-breakdown-count"><%= count %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Write a Review Form -->
      <div class="form-card">
        <div class="section-eyebrow">Share Your Experience</div>
        <h3 class="section-title" style="font-size: clamp(17px, 1.5vw, 20px); margin-bottom: 6px;">Leave a Store Review</h3>
        <p style="font-size: clamp(12px, 0.9vw, 13px); color: var(--gray-500); margin-bottom: 1.25rem; line-height: 1.45;">
          Did you visit our showroom or get a tempered glass fitted? Let others know about your experience.
        </p>

        <form action="/reviews" method="POST">
          <div class="form-group">
            <label class="form-label" for="author_name">Your Name</label>
            <input type="text" id="author_name" name="author_name" class="form-input" placeholder="e.g. Ramesh Kumar (Brookefield)" required>
          </div>

          <div class="form-group">
            <label class="form-label">Your Rating</label>
            <input type="hidden" name="rating" id="rating_input" value="5">
            <div id="star-rating-container" class="rating-star-picker">
              <button type="button" class="rating-star-btn" data-value="1"><%- icon('starFilled', 22) %></button>
              <button type="button" class="rating-star-btn" data-value="2"><%- icon('starFilled', 22) %></button>
              <button type="button" class="rating-star-btn" data-value="3"><%- icon('starFilled', 22) %></button>
              <button type="button" class="rating-star-btn" data-value="4"><%- icon('starFilled', 22) %></button>
              <button type="button" class="rating-star-btn" data-value="5"><%- icon('starFilled', 22) %></button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="comment">Your Feedback</label>
            <textarea id="comment" name="comment" class="form-textarea" placeholder="Tell us about the accessories you bought, fitting quality, or customer service..." required></textarea>
          </div>

          <button type="submit" class="btn btn-orange" style="width: 100%;">
            <%- icon('check', 16) %> Submit Review
          </button>
        </form>
      </div>

    </div>

    <!-- All Reviews List -->
    <div>
      <h2 style="font-size: clamp(18px, 2vw, 24px); margin-bottom: 1.25rem; color: var(--navy);">Recent Customer Testimonials</h2>
      <div class="reviews-grid">
        <% if (reviews && reviews.length > 0) { %>
          <% reviews.forEach(rev => { %>
            <div class="review-card">
              <div class="review-header">
                <div class="review-stars">
                  <% for(let i=0; i<rev.rating; i++) { %>
                    <%- icon('starFilled', 14) %>
                  <% } %>
                </div>
                <span class="review-source"><%= rev.source || 'Google Review' %></span>
              </div>
              <p class="review-text">"<%= rev.comment %>"</p>
              <div class="review-author">
                <div class="review-avatar"><%= (rev.author_name || 'Customer').charAt(0) %></div>
                <div>
                  <div class="review-author-name"><%= rev.author_name || 'Customer' %></div>
                  <div class="review-date"><%= rev.review_date || 'Verified Review' %></div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>

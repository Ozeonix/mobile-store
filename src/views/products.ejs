<!-- Products Catalog Header -->
<section class="section catalog-header-section">
  <div class="container">
    <div class="section-eyebrow" style="color: var(--orange-light)">AECS Layout Showroom Inventory</div>
    <h1 class="catalog-title">All Mobile Accessories</h1>
    <p class="catalog-subtitle">
      Explore our comprehensive in-store range. Inquire on WhatsApp for instant model fitment confirmation and reserve before visiting our showroom.
    </p>

    <!-- Search & Filter Controls -->
    <form action="/products" method="GET" class="catalog-filter-form">
      <div class="filter-input-wrap">
        <span class="filter-search-icon"><%- icon('search', 16) %></span>
        <input type="text" 
               name="q" 
               value="<%= searchQuery || '' %>" 
               placeholder="Search tempered glass, cases, GaN chargers..." 
               class="form-input search-form-input"
               id="product-search-input">
      </div>

      <div class="filter-select-wrap">
        <select name="category" class="form-select" id="filter-category-select">
          <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>All Categories</option>
          <% if (categories) { %>
            <% categories.forEach(c => { %>
              <option value="<%= c.slug %>" <%= selectedCategory === c.slug ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div class="filter-select-wrap">
        <select name="sort" class="form-select" id="filter-sort-select">
          <option value="featured" <%= selectedSort === 'featured' ? 'selected' : '' %>>Sort: Featured</option>
          <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>New Arrivals</option>
        </select>
      </div>

      <button type="submit" class="btn btn-orange filter-submit-btn" id="filter-submit-btn">
        <%- icon('search', 16) %> Search
      </button>
    </form>
  </div>
</section>

<!-- Product List Grid -->
<section class="section">
  <div class="container">
    <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
      <div class="alert alert-error"><%- icon('alertCircle', 16) %> <%= errorMsg %></div>
    <% } %>

    <!-- Category Filter Chips (Horizontal Swipeable on Mobile) -->
    <div class="catalog-category-chips">
      <a href="/products<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>" 
         class="chip-item <%= selectedCategory === 'all' ? 'active' : '' %>">
        <%- icon('grid', 14) %> All (<%= products ? products.length : 0 %>)
      </a>
      <% if (categories) { %>
        <% categories.forEach(c => { %>
          <a href="/products?category=<%= c.slug %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
             class="chip-item <%= selectedCategory === c.slug ? 'active' : '' %>">
            <%- icon(c.icon || 'smartphone', 14) %> <%= c.name %>
          </a>
        <% }) %>
      <% } %>
    </div>

    <!-- Active Filter Info -->
    <% if (searchQuery || selectedCategory !== 'all') { %>
      <div class="filter-status-row">
        <span>Showing results for: <strong><%= searchQuery || selectedCategory %></strong></span>
        <a href="/products" class="clear-filters-link">Clear All Filters</a>
      </div>
    <% } %>

    <% if (products && products.length > 0) { %>
      <div class="product-grid">
        <% products.forEach(prod => { %>
          <div class="product-card" id="product-card-<%= prod.id %>">
            <div class="product-img-wrap">
              <% if (prod.badge) { %>
                <div class="product-badge-pos">
                  <span class="badge badge-<%= prod.badge.toLowerCase() %>"><%= prod.badge %></span>
                </div>
              <% } %>

              <a href="/products/<%= prod.slug || prod.id %>" class="product-img-link">
                <img src="<%= prod.image_url || '/images/hero-banner.png' %>" 
                     alt="<%= prod.name %>" 
                     loading="lazy" 
                     class="product-thumb">
              </a>

              <% if (prod.category_name) { %>
                <span class="product-cat-tag"><%= prod.category_name %></span>
              <% } %>
            </div>

            <div class="product-body">
              <h3 class="product-name">
                <a href="/products/<%= prod.slug || prod.id %>"><%= prod.name %></a>
              </h3>

              <p class="product-desc"><%= prod.description %></p>

              <!-- Price & Stock Row -->
              <div class="product-price-row">
                <div class="price-wrap">
                  <span class="price-current">₹<%= Number(prod.price).toLocaleString('en-IN') %></span>
                  <% if (prod.original_price && Number(prod.original_price) > Number(prod.price)) { %>
                    <span class="price-original">₹<%= Number(prod.original_price).toLocaleString('en-IN') %></span>
                    <% const discount = Math.round(((Number(prod.original_price) - Number(prod.price)) / Number(prod.original_price)) * 100); %>
                    <span class="price-discount-badge"><%= discount %>% OFF</span>
                  <% } %>
                </div>

                <div class="stock-indicator <%= prod.in_stock ? 'in-stock' : 'out-stock' %>">
                  <span class="stock-dot"></span>
                  <span><%= prod.in_stock ? 'In Stock' : 'Out of Stock' %></span>
                </div>
              </div>

              <!-- Action Row -->
              <div class="product-action-row">
                <a href="/products/<%= prod.slug || prod.id %>" class="btn btn-outline btn-sm product-view-btn">
                  Details
                </a>
                <a href="https://wa.me/<%= settings.store_whatsapp || '919876543210' %>?text=<%= encodeURIComponent('Hi Tech Talk Mobile! I want to check availability and buy: ' + prod.name + ' (₹' + prod.price + ')') %>"
                   class="btn btn-whatsapp btn-sm product-wa-btn" 
                   target="_blank" 
                   rel="noopener"
                   title="Reserve on WhatsApp">
                  <%- icon('whatsapp', 15) %> <span class="wa-btn-label">Enquire</span>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state-card">
        <div class="empty-state-icon">
          <%- icon('search', 40) %>
        </div>
        <h3>No Accessories Found</h3>
        <p>No products match your search or filter criteria. Send us a message on WhatsApp for custom phone model inquiries.</p>
        <div style="margin-top: 1.5rem; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
          <a href="/products" class="btn btn-orange">View All Products</a>
          <a href="https://wa.me/<%= settings.store_whatsapp || '919876543210' %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
            <%- icon('whatsapp', 16) %> WhatsApp Us
          </a>
        </div>
      </div>
    <% } %>
  </div>
</section>
